{
	"name": "open-editor2",
	"version": "1.0.0-alpha.1",
	"description": "Open files in your editor at a specific line and column",
	"license": "MIT",
	"repository": "aztack/open-editor2",
	"author": {
		"name": "aztack",
		"email": "aztack@163.com"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"import": "./dist/index.js",
		"require": "./dist/index.cjs"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts",
		"test": "xo && ava && tsd"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"open",
		"editor",
		"launch",
		"files",
		"file",
		"line",
		"column",
		"position",
		"path",
		"filepath",
		"editors",
		"start",
		"app",
		"sublime",
		"atom",
		"vscode",
		"webstorm",
		"textmate",
		"vim",
		"neovim",
		"intellij",
		"emacs",
		"nano"
	],
	"dependencies": {
		"env-editor": "^1.1.0",
		"execa": "^9.3.0",
		"line-column-path": "^3.0.0",
		"open": "^10.1.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.14",
		"ava": "^6.1.3",
		"tsd": "^0.31.1",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3",
		"xo": "^0.58.0"
	}
}
