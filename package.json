{
	"name": "open-editor2",
	"version": "1.0.0-alpha.3",
	"description": "Open files in your editor at a specific line and column",
	"license": "MIT",
	"repository": "aztack/open-editor2",
	"author": {
		"name": "aztack",
		"email": "aztack@163.com"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"import": "./dist/index.js",
		"require": "./dist/index.cjs"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"prepublish": "npm run build",
		"build": "npm run clean && node esbuild.js && npm run tsc",
		"tsc": "tsc --esModuleInterop --declaration src/index.ts --emitDeclarationOnly --outDir ./dist",
		"clean": "rimraf ./dist",
		"example": "bun example.js"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"open",
		"editor",
		"launch",
		"files",
		"file",
		"line",
		"column",
		"position",
		"path",
		"filepath",
		"editors",
		"start",
		"app",
		"sublime",
		"atom",
		"vscode",
		"webstorm",
		"textmate",
		"vim",
		"neovim",
		"intellij",
		"emacs",
		"nano"
	],
	"dependencies": {
		"env-editor": "^1.1.0",
		"execa": "^9.3.0",
		"line-column-path": "^3.0.0",
		"open": "^10.1.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.14",
		"@types/ps-list": "^6.0.0",
		"esbuild": "^0.25.6",
		"esbuild-plugin-replace": "^1.4.0",
		"ps-list": "^8.1.1",
		"rimraf": "^6.0.1",
		"typescript": "^5.8.3"
	}
}
